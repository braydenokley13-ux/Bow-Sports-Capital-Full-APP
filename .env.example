# ========================================
# Bow Sports Capital — environment vars
# Copy to .env.local and fill in real values
# ========================================

# -------- App --------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Bow Sports Capital"

# -------- Supabase (Auth + Postgres + Storage) --------
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# -------- Database (Drizzle direct connection) --------
# Supabase → Project Settings → Database → Connection string
# Use the "transaction" pooler for serverless.
DATABASE_URL=

# -------- Resend (transactional email) --------
# Create a free account at https://resend.com
RESEND_API_KEY=
RESEND_FROM="BOW Sports Capital <noreply@bowsportscapital.com>"

# -------- Feature flags --------
# Set to "1" to use the built-in mock data layer instead of Supabase.
# Useful for local preview without provisioning a DB.
BSC_USE_MOCK_DATA=1

# -------- Admin --------
# Comma-separated list of admin email addresses.
BSC_ADMIN_EMAILS=braydenokley13@gmail.com,bowsportscapitalpodcast@outlook.com
